<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Lobby</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles/styles.css">
    <script type="module" src="/js/chat.js" defer></script>
    <script type="module" src="/js/lobby.js" defer></script>
  </head>
  <body>
    <div class="lobby-page">
      <div class="lobby-container">
        <div class="top-bar">
          <div>
            <h1>Lobby</h1>
            <p>
              Hello <strong><%= user.username %></strong> (#<%= user.id %>)
            </p>
          </div>
          <a href="/auth/logout">Logout</a>
        </div>

        <form method="post" action="/games" class="create-game-form">
          <label for="name">
            Lobby Name
            <input type="text" name="name" placeholder="Optional game name" />
          </label>

          <label for="max_players">
            Max Players
            <select name="max_players">
              <option value="2">2</option>
              <option value="3">3</option>
              <option value="4">4</option>
            </select>
          </label>

          <button type="submit">Create Game</button>
        </form>

        <section>
          <h2>Open Games</h2>
          <div id="game-list" class="game-list"></div>

          <template id="game-listing-template">
            <article class="game-card">
              <header class="game-card-header">
                <span class="game-name"></span>
                <span class="game-state badge"></span>
              </header>

              <div class="game-card-meta">
                <div><span class="label">ID:</span> <span class="game-id"></span></div>
                <div>
                  <span class="label">Host (user id):</span>
                  <span class="game-created-by"></span>
                </div>
                <div>
                  <span class="label">Max players:</span>
                  <span class="max-players"></span>
                </div>
                <div>
                  <span class="label">Created:</span>
                  <span class="created-at"></span>
                </div>
              </div>

              <a class="game-link" href="#">View game</a>
            </article>
          </template>
        </section>
          <section class="chat-card">
          <h2>Global Chat</h2>

          <div id="message-listing" class="chat-messages"></div>

          <form id="message-submit" class="chat-compose">
            <input type="text" placeholder="Type a message…" autocomplete="off" />
            <button type="submit">Send</button>
          </form>

          <template id="template-chat-message">
            <div class="chat-message">
              <span class="message-time"></span>
              <span class="message-username"></span>
              <span class="message-text"></span>
            </div>
          </template>
      </section>
      </div>
    </div>
  </body>
</html>
