<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Game <%= id %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="stylesheet" href="/styles/styles.css">
  <link rel="stylesheet" href="/styles/game.css">
  <link rel="stylesheet" href="/styles/chat.css">
  <script type="module" src="/js/chat.js" defer></script>
  <script type="module" src="/js/game.js" defer></script>

</head>

<body class="container" data-game-id="<%= id %>">

  <header class="nav">
    <div class="nav-left">
      <h2>Game <%= id %></h2>

      <% if (user) { %>
        <span class="user-chip">
          You are: <strong><%= user.username %></strong>
        </span>
      <% } %>
    </div>
    <a href="/lobby">Back to Lobby</a>
  </header>

<section class="players" style="display: none;">
  <h3>Players in this game</h3>

  <% if (players && players.length) { %>
    <ul class="player-list">
      <% players.forEach(function (p) { %>
        <li><%= p.username %></li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No one has joined this game yet.</p>
  <% } %>
</section>

<section class="players">
  <h3>Players in this game</h3>
  <ul id="dynamic-player-list" class="player-list">
    <!-- Initial players from server-side render -->
    <% if (players && players.length) { %>
      <% players.forEach(function (p) { %>
        <li data-user-id="<%= p.id %>"><%= p.username %></li>
      <% }) %>
    <% } else { %>
      <li>No one has joined this game yet.</li>
    <% } %>
  </ul>
</section>

  <section class="card">
    <h3>Game Information</h3>
    <p><strong>Room:</strong> <%= room_id %></p>
    <p><strong>Status:</strong> <%= status %></p>
    <p><strong>Privacy:</strong> <%= privacy %></p>
    <p><strong>Created At:</strong> <%= new Date(created_at).toLocaleString() %></p>
  </section>

