    <div class="hand">
      <div class="card-slot">Card 1</div>
      <div class="card-slot">Card 2</div>
      <div class="card-slot">Card 3</div>
    </div>

    <p class="note">
      (Mock-up only — required for Milestone 4. Real gameplay added later.)
    </p>
  </section> -->

 <!-- In game.ejs, make sure the hand container is a flex row -->
<section class="card">
  <h3>Mini-UNO</h3>

  <div class="board-row">
    <button id="draw-btn" class="card-slot1">🂠 Draw</button>
    <div id="top-card" class="card-slot">Top Card: (not started)</div>
  </div>

  <div class="board-row">
    <button id="start-btn" class="card-slot1">Start Game</button>
    <div id="turn-indicator" class="card-slot">Turn: —</div>
  </div>

  <h4>Your Hand</h4>
  <div id="hand" class="hand"></div>

  <p id="status-line" class="note"></p>
</section>


  <section class="chat-card">
  <h3>Game Chat</h3>

  <div id="message-listing" class="chat-messages"></div>

  <form id="message-submit" class="chat-compose">
    <input type="text" placeholder="Type a message…" autocomplete="off" />
    <button type="submit">Send</button>
  </form>

  <template id="template-chat-message">
    <div class="chat-message">
      <span class="message-time"></span>
      <span class="message-username"></span>
      <span class="message-text"></span>
    </div>
  </template>
</section>

</body>
</html>
